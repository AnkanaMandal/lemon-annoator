# Copy to frontend/.env.local for local development. On Vercel, add the same names under
# Project Settings > Environment Variables (they are built into the app, so redeploy after changing them).

# Supabase > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase > Project Settings > API Keys > Publishable key (sb_publishable_...). The legacy "anon" key works too.
# This key is public by design; never put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Production only: the Render URL of the API, e.g. https://lemon-api.onrender.com
# Leave it empty locally; /api is then proxied to BACKEND_URL.
NEXT_PUBLIC_API_URL=

# Local development only: where /api requests are proxied (npm run dev sets this for you).
BACKEND_URL=http://127.0.0.1:8000
