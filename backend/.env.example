# Copy to backend/.env for local development. On Render, set the same names as environment variables.

# Supabase > Connect (top bar) > Connection String > "Session pooler". Replace [YOUR-PASSWORD] with
# the database password. (The "Direct connection" string is IPv6-only and does not work from Render.)
LEMON_DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase > Project Settings > Data API > Project URL. Used to verify sign-in tokens.
LEMON_SUPABASE_URL=https://<project-ref>.supabase.co

# Only if your project still uses the legacy JWT secret (Project Settings > JWT Keys > Legacy JWT secret).
# New projects use signing keys and need nothing here.
LEMON_SUPABASE_JWT_SECRET=

# Emails allowed to use the API (comma-separated). Empty: anyone with an account in your Supabase project.
LEMON_ALLOWED_EMAILS=you@example.com,friend@example.com

# Browser origins allowed to call the API: your Vercel URL in production, localhost for development.
LEMON_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for extra origins, e.g. Vercel preview deployments:
# LEMON_CORS_ORIGIN_REGEX=https://lemon-[a-z0-9-]+\.vercel\.app

# Tables live in this Postgres schema (created on startup).
LEMON_DB_SCHEMA=lemon

# Max S3 objects scanned per listing (protects against enormous buckets).
LEMON_MAX_LIST_KEYS=50000

# AWS credentials can be entered per project in the UI. Leaving them empty there makes the API use
# these instead, which keeps them out of the database:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
