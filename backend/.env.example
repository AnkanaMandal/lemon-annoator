# All settings are optional; defaults work out of the box.

# Where projects, annotations and exports are stored (relative paths are from the repo root).
LEMON_DATA_DIR=./app_data

# Origins allowed to call the API directly from a browser. The Next.js app proxies
# /api through its own server, so you only need this if you call the API yourself.
LEMON_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Host names the API answers to (protects against DNS rebinding). Only change this if you
# deliberately expose Lemon under another name.
LEMON_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Max S3 objects scanned per listing (protects against enormous buckets).
LEMON_MAX_LIST_KEYS=50000

# AWS credentials are entered per project in the UI. If you leave the keys empty
# there, boto3 falls back to the standard chain, so these also work:
# AWS_PROFILE=my-profile
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
